# SQLite database file (relative paths are relative to backend/)
# DB_PATH=data/alphamonitor.db
DB_BUSY_TIMEOUT_MS=5000

# Upstream calls API used by the "Telegram" feed
CALLS_API_URL=http://localhost:8000/api/feed/calls

# Telegram user-account credentials for Telethon (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Session file name (created by `python -m app.cli login`)
TG_SESSION=alphamonitor

# Feed definitions (the four TokenScan feeds)
FEEDS_FILE=feeds.json
# How many past messages to pull from each chat on startup
BACKFILL_LIMIT=50

# Comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shrine data API key (sk_...) for the price charts behind the top tokens of each feed
SHRINE_API_KEY=
# "auto" tries the known Shrine endpoints; `python -m app.cli charts-check` prints which one works
SHRINE_DATA_URL=auto
# SHRINE_SOCKETIO_PATH=socket.io
CHART_REFRESH_SECONDS=10
